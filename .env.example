# Copy to your local .env, which Git ignores. NEVER commit active credentials.
# Rotate/revoke any previously published credentials or tokens.
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=

# Free read-only Upstox Analytics Token for live option chain
UPSTOX_ANALYTICS_TOKEN=

MYTRADE_DATA_DIR=data
